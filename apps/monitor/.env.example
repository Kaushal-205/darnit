# Use the actual module address and its deployment block after M7.
CHAIN_ID=84532
RPC_URLS=https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com
FIREWALL_MODULE=
START_BLOCK=0
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
SAFE7579_ADDRESS=0x7579EE8307284F293B1927136486880611F20002
PONDER_POLLING_INTERVAL_MS=1000
# Set Postgres in production. Blank uses local PGlite and an in-memory worker store.
DATABASE_URL=
WORKER_DB_SCHEMA=monitor_worker
INDEXER_URL=http://localhost:42069
WORKER_POLL_INTERVAL_MS=1000
PORT=8787
APP_URL=https://your-firewall-app.example
# Configure only the channels you want to enable; keep secrets out of client bundles.
EMAIL_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
WEBHOOK_SIGNING_SECRET=
# Local test receivers only. Leave false in production.
ALLOW_INSECURE_WEBHOOKS=false
PONDER_TELEMETRY_DISABLED=true
