{
  "name": "@session-firewall/monitor",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "abis": "node scripts/gen-abis.mjs && biome format --write abis",
    "dev": "ponder dev",
    "start": "ponder start",
    "worker": "node --experimental-strip-types worker/main.ts",
    "codegen": "ponder codegen",
    "typecheck": "ponder codegen && tsc --noEmit",
    "lint": "biome check abis src worker test scripts ponder.config.ts ponder.schema.ts ponder-env.d.ts package.json tsconfig.json",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e --disable-console-intercept"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "hono": "4.13.9",
    "pg": "8.23.1",
    "ponder": "0.18.2",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.13",
    "@types/node": "22.19.21",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
