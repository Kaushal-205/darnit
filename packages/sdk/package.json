{
  "name": "@session-firewall/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TypeScript SDK for Session Firewall: Safe + Safe7579 accounts guarded by the firewall hook, with Smart Sessions session keys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "abi": "tsx scripts/extract-abis.ts",
    "demo": "tsx scripts/demo.ts",
    "verify:infrastructure": "tsx scripts/verify-infrastructure.ts"
  },
  "dependencies": {
    "permissionless": "0.5.2",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
